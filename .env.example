# Environment variables
OLLAMA_MODEL=llama3.2

OLLAMA_BASE_URL=http://localhost:11434

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

CHROMA_DB=./data/chroma_db

TOP_K=4

# Max retrieve+grade attempts before falling back to web search / honest failure
MAX_ATTEMPTS=2

# DuckDuckGo web fallback when documents lack the answer (true/false)
WEB_SEARCH=true

# Hybrid retrieval: candidates fetched per retriever (dense + BM25) before RRF fusion
HYBRID_CANDIDATES=10

# Cross-encoder reranker (bge-reranker-base runs locally on CPU)
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-base
RERANK_TOP_N=4

# Sentence-level knowledge strips before the answer (true/false)
STRIPS_ENABLED=true

# SQLite telemetry of loop branches + latency (data/telemetry.db)
TELEMETRY_ENABLED=true

# OCR fallback for scanned/image-only PDFs (needs the tesseract binary)
OCR_ENABLED=true

# Answer-groundedness verify node + one regeneration retry (true/false)
VERIFY_ENABLED=true
MAX_VERIFY_ATTEMPTS=1